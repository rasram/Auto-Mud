[Unit]
Description=AutoMUD isolated engineering observation testbed
After=network-online.target openvswitch-switch.service automud-controller.service automud-finalizer.service
Requires=openvswitch-switch.service automud-controller.service
Wants=automud-finalizer.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/automud/Auto-Mud
ExecStart=/usr/bin/python3 -m network.testbed.live_topology --config configs/live/saturn.json --no-cli --engineering-traffic
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=40
UMask=0022

[Install]
WantedBy=multi-user.target
